{
    "manifest_version": 3,
    "name": "CyberGuard",
    "version": "1.0",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Get Analysis"
    },
    "permissions":[
        
        "activeTab",
        "tabs"
    ],
    "host_permissions":[
        "https://dns.google/*",
        "https://ipinfo.io/*"
    ],
    "content_scripts":[
        {
            "matches": ["<all_urls>"],
            "js": ["analyze.js","content.js"]
        }
    ]
    

    
        
    
}