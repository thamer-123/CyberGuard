{
  "manifest_version": 3,
  "name": "CyberGuard",
  "version": "1.0",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Get Analysis"
  },

  "permissions": ["activeTab", "tabs"],

  "host_permissions": [
    "https://dns.google/*",
    "https://ipinfo.io/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ]
}

